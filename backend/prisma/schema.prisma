// Prisma Schema for Ticket Cinema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ENDED
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
}

enum BookingStatus {
  HOLDING     // Đang giữ ghế 5 phút
  CONFIRMED   // Đã thanh toán thành công
  CANCELLED   // Đã hủy vé
  EXPIRED     // Hết hạn 5 phút giữ ghế
}

enum TicketStatus {
  HELD
  BOOKED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String    // bcrypt hash
  fullName  String
  phone     String?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]

  @@map("users")
}

model Movie {
  id           String      @id @default(uuid())
  title        String
  englishTitle String?
  genres       String      // Ví dụ: "Hành Động, Khoa Học Viễn Tưởng"
  duration     Int         // Thời lượng (phút)
  releaseDate  DateTime
  ageRating    String      // P, T13, T16, T18
  posterUrl    String
  trailerUrl   String?
  description  String
  status       MovieStatus @default(NOW_SHOWING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  showtimes    Showtime[]

  @@map("movies")
}

model Cinema {
  id        String   @id @default(uuid())
  name      String   // VD: "CineStar Landmark 81", "CineStar Hai Bà Trưng"
  address   String
  city      String   @default("Hà Nội")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms     Room[]

  @@map("cinemas")
}

model Room {
  id          String   @id @default(uuid())
  cinemaId    String
  name        String   // VD: "Phòng Chiếu 1 (2D Standard)", "Phòng Chiếu 2 (IMAX)"
  totalRows   Int
  seatsPerRow Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cinema      Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats       Seat[]
  showtimes   Showtime[]

  @@map("rooms")
}

model Seat {
  id              String   @id @default(uuid())
  roomId          String
  row             String   // A, B, C...
  number          Int      // 1, 2, 3...
  type            SeatType @default(STANDARD)
  priceMultiplier Float    @default(1.0) // 1.0 (STANDARD), 1.25 (VIP), 1.5 (COUPLE)

  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets         Ticket[]

  @@unique([roomId, row, number])
  @@map("seats")
}

model Showtime {
  id         String     @id @default(uuid())
  movieId    String
  roomId     String
  startTime  DateTime
  endTime    DateTime
  basePrice  Float      // Giá vé gốc (VD: 80.000 VNĐ)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  tickets    Ticket[]

  @@index([startTime, roomId])
  @@map("showtimes")
}

model Booking {
  id            String        @id @default(uuid())
  bookingCode   String        @unique // VD: "BK-20261029-A8F2"
  userId        String
  showtimeId    String
  totalPrice    Float
  status        BookingStatus @default(HOLDING)
  holdExpiresAt DateTime      // Thời điểm hết hạn 5 phút giữ ghế
  paymentMethod String?       // "MOCK_MOMO", "MOCK_VNPAY", "MOCK_CARD"
  paymentTime   DateTime?
  qrCodeData    String?       // Chuỗi dữ liệu mã hóa để tạo QR Code vé
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime      Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  tickets       Ticket[]

  @@index([userId, status])
  @@map("bookings")
}

model Ticket {
  id          String       @id @default(uuid())
  ticketCode  String       @unique // VD: "TKT-DUNE2-E5-9A82"
  bookingId   String
  showtimeId  String
  seatId      String
  price       Float
  status      TicketStatus @default(HELD)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtime    Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat        Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)

  // RÀNG BUỘC CỐT LÕI: Không bao giờ trùng vé cho cùng 1 ghế trong 1 suất chiếu
  @@unique([showtimeId, seatId])
  @@index([showtimeId, status])
  @@map("tickets")
}
