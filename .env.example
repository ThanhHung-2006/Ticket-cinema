# ==============================================================================
# TICKET CINEMA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_cinema?schema=public"

# JWT Authentication Secrets
JWT_SECRET="ticket_cinema_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000/api"

# Seat Hold Time (in minutes)
SEAT_HOLD_DURATION_MINUTES=5
